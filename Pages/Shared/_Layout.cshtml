<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DataSearch</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header style="padding:10px 20px;border-bottom:1px solid #ddd;">
        <strong>DataSearch</strong>
        <span style="float:right;">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span>@User.Identity.Name</span>
                <a href="/Logout" style="margin-left:10px;">Logout</a>
            }
            else
            {
                <a href="/Login">Login</a>
                <a href="/Register" style="margin-left:10px;">Register</a>
            }
        </span>
    </header>
    <main style="padding:20px;max-width:1100px;margin:0 auto;">
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>