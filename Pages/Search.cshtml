@page
@model DataSearch.Pages.SearchModel
<h2>Search Records</h2>
@if (!string.IsNullOrEmpty(Model.Message)) { <div class="msg">@Model.Message</div> }

<div class="form-box">
<form method="post">
    <div class="search-bar">
        <div class="search-field">
            <label>State</label>
            <select asp-for="State">
                <option value="">All</option>
                <option value="Karnataka">Karnataka</option>
                <option value="Andhra Pradesh">Andhra Pradesh</option>
            </select>
        </div>
        <div class="search-field"><label>Phone Number</label><input asp-for="PhoneNumber" /></div>
        <div class="search-field"><label>Name</label><input asp-for="OwnerName" /></div>
        <div class="search-field"><label>Father Name</label><input asp-for="FatherName" /></div>
        <div class="search-field"><label>Address</label><input asp-for="Address" /></div>
        <div class="search-field"><label>ID (Aadhaar)</label><input asp-for="AadhaarId" /></div>
        <div class="search-field"><label>Alternative Number</label><input asp-for="AlternativeNumber" /></div>
        <div class="search-field"><label>Circle</label><input asp-for="Circle" /></div>
        <button type="submit">Search</button>
    </div>
</form>
</div>

@if (Model.Results != null)
{
    <div class="card" style="margin-top:18px;">
        <div class="meta">Found <strong>@Model.Total</strong> results &middot; Page @Model.CurrentPage</div>
        <table>
            <thead>
                <tr>
                    <th>State</th><th>Phone</th><th>Name</th><th>Father</th><th>Address</th><th>ID</th><th>Alt No</th><th>Circle</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Results)
            {
                <tr>
                    <td>@r.State</td>
                    <td>@r.PhoneNumber</td>
                    <td>@r.OwnerName</td>
                    <td>@r.FatherName</td>
                    <td>@r.Address</td>
                    <td>@r.AadhaarId</td>
                    <td>@r.AlternativeNumber</td>
                    <td>@r.Circle</td>
                </tr>
            }
            </tbody>
        </table>
        <div class="pager">
            @if (Model.CurrentPage > 1) { <a href="?page=@(Model.CurrentPage-1)&state=@Model.State&phoneNumber=@Model.PhoneNumber&ownerName=@Model.OwnerName&fatherName=@Model.FatherName&address=@Model.Address&aadhaarId=@Model.AadhaarId&alternativeNumber=@Model.AlternativeNumber&circle=@Model.Circle">Prev</a> }
            @if (Model.HasMore) { <a href="?page=@(Model.CurrentPage+1)&state=@Model.State&phoneNumber=@Model.PhoneNumber&ownerName=@Model.OwnerName&fatherName=@Model.FatherName&address=@Model.Address&aadhaarId=@Model.AadhaarId&alternativeNumber=@Model.AlternativeNumber&circle=@Model.Circle">Next</a> }
        </div>
    </div>
}