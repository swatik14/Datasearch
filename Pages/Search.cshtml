@page
@model DataSearch.Pages.SearchModel
<h2>Search</h2>
@if (!string.IsNullOrEmpty(Model.Message)) { <div style="color:red">@Model.Message</div> }

<form method="post">
    <div class="form-row">
        <label>State</label>
        <select asp-for="State">
            <option value="">-- select --</option>
            <option value="Karnataka">Karnataka</option>
            <option value="Andhra Pradesh">Andhra Pradesh</option>
        </select>
    </div>
    <div class="form-row"><label>Phone Number</label><input asp-for="PhoneNumber" /></div>
    <div class="form-row"><label>Name</label><input asp-for="OwnerName" /></div>
    <div class="form-row"><label>Father Name</label><input asp-for="FatherName" /></div>
    <div class="form-row"><label>Address</label><input asp-for="Address" /></div>
    <div class="form-row"><label>ID (Aadhaar)</label><input asp-for="AadhaarId" /></div>
    <div class="form-row"><label>Alternative Number</label><input asp-for="AlternativeNumber" /></div>
    <div class="form-row"><label>Circle</label><input asp-for="Circle" /></div>
    <button type="submit">Search</button>
</form>

@if (Model.Results != null)
{
    <p>Found @Model.Total results. Page @Model.CurrentPage</p>
    <table>
        <thead>
            <tr>
                <th>State</th><th>Phone</th><th>Name</th><th>Father</th><th>Address</th><th>ID</th><th>Alt No</th><th>Circle</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.Results)
        {
            <tr>
                <td>@r.State</td>
                <td>@r.PhoneNumber</td>
                <td>@r.OwnerName</td>
                <td>@r.FatherName</td>
                <td>@r.Address</td>
                <td>@r.AadhaarId</td>
                <td>@r.AlternativeNumber</td>
                <td>@r.Circle</td>
            </tr>
        }
        </tbody>
    </table>
    <div style="margin-top:10px;">
        @if (Model.CurrentPage > 1) { <a href="?page=@(Model.CurrentPage-1)&state=@Model.State&phoneNumber=@Model.PhoneNumber&ownerName=@Model.OwnerName&fatherName=@Model.FatherName&address=@Model.Address&aadhaarId=@Model.AadhaarId&alternativeNumber=@Model.AlternativeNumber&circle=@Model.Circle">Prev</a> }
        @if (Model.HasMore) { <a href="?page=@(Model.CurrentPage+1)&state=@Model.State&phoneNumber=@Model.PhoneNumber&ownerName=@Model.OwnerName&fatherName=@Model.FatherName&address=@Model.Address&aadhaarId=@Model.AadhaarId&alternativeNumber=@Model.AlternativeNumber&circle=@Model.Circle" style="margin-left:10px;">Next</a> }
    </div>
}